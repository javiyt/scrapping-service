[Unit]
Description=Scraper API container (full deployment — private network with SearXNG + Camofox)
Documentation=https://github.com/javiyt/scrapping-service
Wants=scraper-api-network.network
After=network-online.target scraper-api-network.network

[Container]
Image=localhost/scraper-api:latest
ContainerName=scraper-api
# Shared private network: SearXNG and Camofox are reachable by container
# name (`http://searxng:8080` / `http://camofox:9377`) and are NOT exposed
# on the host.  Only the scraper API port is published.
Network=scraper-network
Port=8080:8080
# Temporary Raspberry rootless Podman workaround: the built image rootfs is
# currently mounted with "/" inaccessible to the non-root scraper user.
# Remove this once the image build preserves executable root traversal.
User=0
Volume=%h/scraper-api/configs/config.yaml:/config/config.yaml:ro,z
Volume=%h/scraper-api/data:/data:z
Volume=%h/scraper-api/debug:/debug:z
Volume=%h/scraper-api/logs:/logs:z
Environment=CONFIG_PATH=/config/config.yaml
Environment=SCRAPER_SERVER_PORT=8080
Environment=LOG_LEVEL=info
Environment=TIMEOUT_KEEP_ALIVE=30
Environment=LIMIT_MAX_REQUESTS=5000
Environment=SCRAPER_CACHE_SQLITE_PATH=/data/scraper-cache.db
Environment=SCRAPER_DEBUG_DIR=/debug
Environment=SCRAPER_SCRAPER_MAX_CONCURRENCY=1
Environment=SCRAPER_BROWSER_IDLE_TIMEOUT_SECONDS=60
Environment=SCRAPER_BROWSER_MAX_USES=25
Environment=SCRAPER_BROWSER_MAX_POOL_SIZE=1
# --- External search dependencies (see docs/deployment.md) ---
# Base URLs use container-name DNS on the private network.  Enable or
# disable each independently — the service degrades cleanly when a backend
# is down (reported in /health/deep, never fatal to the restart policy).
Environment=SCRAPER_SEARCH_SEARXNG_ENABLED=true
Environment=SCRAPER_SEARCH_SEARXNG_BASE_URL=http://searxng:8080
Environment=SCRAPER_CAMOFOX_ENABLED=true
Environment=SCRAPER_CAMOFOX_BASE_URL=http://camofox:9377
# Secrets (CAMOFOX_ACCESS_KEY, CAMOFOX_API_KEY, SCRAPER_API_KEY) come from
# the environment file — never literal values in the repo.
EnvironmentFile=%h/scraper-api/.env
Environment=TZ=Europe/Madrid
Exec=python /app/app/run.py
# Note: deploy.sh patches Environment= values based on config/config.yaml or .env
# The app/run.py wrapper normalizes LOG_LEVEL and builds the uvicorn command
HealthCmd=python -c 'import urllib.request; import sys; urllib.request.urlopen("http://127.0.0.1:8080/health/deep"); sys.exit(0)'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
