# =============================================================================
# Scraper API — Environment variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Environment variables take priority over configs/config.yaml.
# =============================================================================

# API key required for all authenticated endpoints.
SCRAPER_API_KEY=change-me

# Additional API keys for named profiles (see ``auth.api_keys`` in config.yaml).
SCRAPER_API_KEY_DEBUG=change-me-debug

# Server port (overrides configs/config.yaml server.port).
# SCRAPER_SERVER_PORT=9090

# Config file path (mounted volume in container).
CONFIG_PATH=/config/config.yaml

# Cache database path (persistent volume in container, relative for local use).
SCRAPER_CACHE_SQLITE_PATH=data/scraper-cache.db

# Debug output directory.
SCRAPER_DEBUG_DIR=debug

# Search — SearXNG provider (disabled by default; see the ``search`` block in
# configs/config.yaml). The instance must allow JSON output
# (search.formats: [html, json] in its settings.yml).
# SCRAPER_SEARCH_SEARXNG_ENABLED=true
# SCRAPER_SEARCH_SEARXNG_BASE_URL=http://searxng:8080
# SCRAPER_SEARCH_SEARXNG_TIMEOUT_SECONDS=15
# SCRAPER_SEARCH_SEARXNG_DEFAULT_LANGUAGE=en
# SCRAPER_SEARCH_SEARXNG_CONFIG_CACHE_TTL_SECONDS=3600

# Search — Camofox provider (browser-based Google/Reddit/YouTube via the
# Camofox search macros; requires the camofox client section below).
# SCRAPER_SEARCH_CAMOFOX_ENABLED=true
# SCRAPER_SEARCH_CAMOFOX_MAX_RESULTS=20

# Browser — Camofox fallback.  Botasaurus is the primary browser engine;
# Camofox is an optional *fallback* the scraper service tries when the
# primary fails.  It reuses the same top-level `camofox:` client (see
# below), so no extra credentials are needed.  The backend selection lives
# in the `browser:` section (`fallback_backends: ["camofox"]`); the client
# itself is controlled here.
# SCRAPER_CAMOFOX_ENABLED=true
# SCRAPER_CAMOFOX_BASE_URL=http://camofox:9377
# SCRAPER_CAMOFOX_ACCESS_KEY=your-camofox-access-key
# SCRAPER_CAMOFOX_API_KEY=your-camofox-api-key

# Agent browser — interactive, stateful browsing API (/v1/browser/...).
# Off by default. Requires the `camofox:` client above to be enabled.
#   SCRAPER_AGENT_BROWSER_ENABLED              enable /v1/browser
#   SCRAPER_AGENT_BROWSER_ALLOW_EVALUATE       allow JavaScript evaluate (default false)
#   SCRAPER_AGENT_BROWSER_MAX_SESSIONS         max active sessions per profile
#   SCRAPER_AGENT_BROWSER_MAX_TABS_PER_SESSION max open tabs per session
#   SCRAPER_AGENT_BROWSER_SESSION_TTL_SECONDS  idle TTL before a session is released
#   SCRAPER_AGENT_BROWSER_CLEANUP_INTERVAL_SECONDS  maintenance sweep interval
#   SCRAPER_AGENT_BROWSER_OPERATION_TIMEOUT_SECONDS per-operation timeout
# SCRAPER_AGENT_BROWSER_ENABLED=true
# SCRAPER_AGENT_BROWSER_MAX_SESSIONS=5
# SCRAPER_AGENT_BROWSER_MAX_TABS_PER_SESSION=3

# Search — result cache policy (cache_ttl_seconds / force_refresh in a request
# override it per request).
# SCRAPER_SEARCH_CACHE_ENABLED=true
# SCRAPER_SEARCH_CACHE_DEFAULT_TTL_SECONDS=900
# SCRAPER_SEARCH_CACHE_STALE_IF_ERROR=true

# Transcript — Camofox provider (backed by the shared `camofox:` client;
# connection settings live in that section). `timeout_seconds` overrides
# camofox.timeout_seconds for transcript requests only.
# SCRAPER_TRANSCRIPT_CAMOFOX_ENABLED=true
# SCRAPER_TRANSCRIPT_CAMOFOX_TIMEOUT_SECONDS=120
# SCRAPER_TRANSCRIPT_CAMOFOX_HEALTH_PROBE=true

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Plugins —Automatic installation at container start
# =============================================================================
# Comma or space-separated pip requirement specifiers for plugins.
# SCRAPER_PLUGINS="my-custom-search>=1.0.0,another-plugin==2.1.0"

# Plugin installation directory (configurable via SCRAPER_PLUGINS_DIR)
# SCRAPER_PLUGINS_DIR=/app/plugins

# Constraints file path (default /app/requirements.txt)
# SCRAPER_PLUGINS_CONSTRAINTS=/app/requirements.txt

# Primary PyPI index URL (credentials will be redacted in logs)
# SCRAPER_PLUGINS_INDEX_URL=https://pypi.example.com/simple

# Extra PyPI index URL (credentials will be redacted in logs)
# SCRAPER_PLUGINS_EXTRA_INDEX_URL=https://extra.pypi.example.com/simple

# Requirements file for offline/installation with hashes
# SCRAPER_PLUGINS_REQUIREMENTS_FILE=/path/to/requirements.txt

# Offline mode: install only from wheelhouse (true/false)
# SCRAPER_PLUGINS_OFFLINE=false

# Wheelhouse directory for offline mode
# SCRAPER_PLUGINS_WHEELHOUSE=/plugins/wheels

# Failure policy: fail (default) or warn
# SCRAPER_PLUGINS_ON_ERROR=fail
